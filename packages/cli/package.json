  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarmclawai/agentready.git"
  },
  "bugs": {
    "url": "https://github.com/swarmclawai/agentready/issues"
  },
  "homepage": "https://github.com/swarmclawai/agentready#readme"
