{
  "name": "@swarmclawai/agentready",
  "version": "0.1.0-alpha.0",
  "description": "Open-source readiness scanner for the agentic web.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentready": "dist/index.cjs"
  },
  "main": "dist/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
